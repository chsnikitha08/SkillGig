# MongoDB connection string. Must point at a replica set (Atlas clusters are),
# because money operations run inside MongoDB transactions.
MONGODB_URI=
# Long random string used to sign login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
# Token lifetime
JWT_EXPIRES_IN=7d
# Frontend origin allowed by CORS and Socket.io (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173
PORT=5050
NODE_ENV=development
# Razorpay TEST mode keys (Dashboard > Account & Settings > API Keys, with Test Mode on).
# Never use live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: secret you set when adding a webhook (events: payment.captured, order.paid)
# pointing at https://<api-host>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
